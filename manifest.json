{
  "manifest_version": 3,
  "name": "Block Websites",
  "version": "1.0",
  "description": "Block specific websites for whatever reason",

  "permissions": [
    "declarativeNetRequest"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}