{
  "manifest_version": 3,
  "name": "Google AI Search",
  "version": "1.0",
  "description": "Automatically adds -ai to Google searches.",
  "permissions": [
    "declarativeNetRequest"
  ],
 "host_permissions": [
  "*://*.google.com/*",
  "*://*.google.co.in/*"
],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}